{
  "name": "@test-tss/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "generate:schema": "pnpm dlx @better-auth/cli@latest generate --config ./src/index.ts --output ../db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@test-tss/db": "workspace:*",
    "@test-tss/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@test-tss/config": "workspace:*",
    "typescript": "catalog:"
  }
}
