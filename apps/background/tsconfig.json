{
  "extends": "@test-tss/config/tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../../packages/email/**/*.tsx"],
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true,
    "skipLibCheck": true
  }
}
